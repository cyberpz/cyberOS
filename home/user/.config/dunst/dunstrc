[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 100
    offset = 10x10
    origin = top-right
    transparency = 0
    frame_color = "#00ff41"
    font = JetBrains Mono 10
    markup = yes
    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#050510"
    foreground = "#c7c7d9"
    timeout = 5

[urgency_normal]
    background = "#050510"
    foreground = "#c7c7d9"
    timeout = 10

[urgency_critical]
    background = "#ff3b3b"
    foreground = "#ffffff"
    timeout = 0
